# Número do WhatsApp (formato internacional, sem + ou espaços)
VITE_WHATSAPP_NUMBER=5511942232220

# API Java (Fly.io) — configure após deploy da API
# VITE_API_URL=https://unipet-api.fly.dev

# Site em produção: https://unipet1.com (também funciona em https://unipet1.netlify.app)
# VITE_TENANT_SLUG=unipet

# Mercado Pago — chave pública (frontend / Payment Brick)
VITE_MERCADOPAGO_PUBLIC_KEY=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Mercado Pago — access token (APENAS Netlify Functions / servidor)
# Configure no painel Netlify: Site settings → Environment variables
# MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxx-xxxx
